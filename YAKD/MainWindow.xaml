<Window x:Class="YAKD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:YAKD.Localization"
        mc:Ignorable="d"
        Title="YAKD - Yet Another Key Displayer"
        Height="660"
        Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        Foreground="#1E1E1E"
        FontFamily="{StaticResource RobotoRegular}"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <Style x:Key="ColorPickerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" 
                                BorderThickness="1"
                                BorderBrush="#FFACACAC" 
                                SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF3399FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFCCCEDB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="9,0,9,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="8*" />
            <RowDefinition Height="11*" />
            <RowDefinition Height="14*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="{loc:Localize MainWindow_KeyDisplayerGroup}" Margin="0,9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <RadioButton x:Name="RTSSRadioButton"
                             Grid.Row="0"
                             Content="{loc:Localize MainWindow_RtssRadioButton}"
                             GroupName="KeyDisplayerMode"
                             Padding="3,0,0,0"
                             VerticalContentAlignment="Center"
                             Checked="RTSSRadioButton_Checked" />
                <RadioButton x:Name="WindowRadioButton"
                             Grid.Row="1"
                             Content="{loc:Localize MainWindow_WindowRadioButton}"
                             GroupName="KeyDisplayerMode"
                             Padding="3,0,0,0"
                             VerticalContentAlignment="Center"
                             Checked="WindowRadioButton_Checked" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="{loc:Localize MainWindow_KeysGroup}" Margin="0,9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <CheckBox x:Name="MouseHookCheckBox"
                          Grid.Row="0"
                          Content="{loc:Localize MainWindow_TrackMouseCheckBox}"
                          VerticalContentAlignment="Center"
                          Checked="MouseHookCheckBox_Checked"
                          Unchecked="MouseHookCheckBox_Unchecked"
                          PreviewKeyDown="CheckBox_PreviewKeyDown"/>
                <CheckBox x:Name="ShortNameForNumpadCheckBox"
                          Grid.Row="1"
                          Content="{loc:Localize MainWindow_ShortNameForNumpadCheckBox}"
                          VerticalContentAlignment="Center"
                          Click="ShortNameForNumpadCheckBox_Click"
                          PreviewKeyDown="CheckBox_PreviewKeyDown" />
                <CheckBox x:Name="IgnoreLeftRightCheckBox"
                          Grid.Row="2"
                          Content="{loc:Localize MainWindow_IgnoreLeftRightCheckBox}"
                          VerticalContentAlignment="Center"
                          Click="IgnoreLeftRightCheckBox_Click"
                          PreviewKeyDown="CheckBox_PreviewKeyDown" />
                <CheckBox x:Name="UseArrowIconsCheckBox"
                          Grid.Row="3"
                          Content="{loc:Localize MainWindow_UseArrowIconsCheckBox}"
                          VerticalContentAlignment="Center"
                          Click="UseArrowIconsCheckBox_Click"
                          PreviewKeyDown="CheckBox_PreviewKeyDown" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="{loc:Localize MainWindow_WindowGroup}" Margin="0,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="7*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Localize MainWindow_BackgroundColorLabel}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Button x:Name="BackgroundColorRectangle"
                            Grid.Column="1"
                            Click="BackgroundColorRectangle_Click"
                            Margin="0"
                            Height="23"
                            Width="Auto"
                            Background="#000000"
                            Style="{StaticResource ColorPickerButtonStyle}" />
                </Grid>
                <Grid Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Localize MainWindow_OpacityLabel}" VerticalAlignment="Center" />
                    <Slider x:Name="OpacitySlider"
                            Grid.Column="1"
                            LargeChange="10"
                            Maximum="100"
                            Minimum="1"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            HorizontalContentAlignment="Stretch"
                            ValueChanged="OpacitySlider_ValueChanged"
                            SmallChange="1"
                            VerticalAlignment="Center"
                            Margin="3,1,3,0" />
                    <TextBox x:Name="OpacityTextBox"
                             Grid.Column="2"
                             Width="60"
                             Height="23"
                             Style="{StaticResource VisualStudioTextBoxStyle}"
                             HorizontalContentAlignment="Center"
                             MaxLength="4"
                             TextChanged="OpacityTextBox_TextChanged" />
                </Grid>
                <Grid Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Localize MainWindow_DelayLabel}" VerticalAlignment="Center" />
                    <Slider x:Name="DisplayDelaySlider"
                            Grid.Column="1"
                            LargeChange="100"
                            Maximum="5000"
                            Minimum="0"
                            IsSnapToTickEnabled="True"
                            TickFrequency="50"
                            HorizontalContentAlignment="Stretch"
                            ValueChanged="DisplayDelaySlider_ValueChanged"
                            SmallChange="50"
                            VerticalAlignment="Center"
                            Margin="3,0,3,0" />
                    <TextBlock x:Name="DisplayDelayTextBlock"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Grid>
                <CheckBox x:Name="DemoKeysCheckBox"
                          Grid.Column="1"
                          Grid.Row="0"
                          Content="{loc:Localize MainWindow_DemoKeysCheckBox}"
                          VerticalAlignment="Center"
                          Margin="9,5,0,5"
                          VerticalContentAlignment="Center"
                          Click="DemoKeysCheckBox_Click"
                          PreviewKeyDown="CheckBox_PreviewKeyDown" />
                <CheckBox x:Name="ResizeCheckBox"
                          Grid.Column="1"
                          Grid.Row="1"
                          Content="{loc:Localize MainWindow_ResizeCheckBox}"
                          VerticalAlignment="Center"
                          Margin="9,5,0,5"
                          VerticalContentAlignment="Center"
                          Click="ResizeCheckBox_Click"
                          PreviewKeyDown="CheckBox_PreviewKeyDown" />
                <CheckBox x:Name="FixWindowCheckBox"
                          Grid.Column="1"
                          Grid.Row="2"
                          Content="{loc:Localize MainWindow_FixWindowCheckBox}"
                          VerticalAlignment="Center"
                          Margin="9,5,0,5"
                          VerticalContentAlignment="Center"
                          Click="FixWindowCheckBox_Click"
                          PreviewKeyDown="CheckBox_PreviewKeyDown" />
                <CheckBox x:Name="ClickThroughWindowCheckBox"
                          Grid.Column="1"
                          Grid.Row="3"
                          Content="{loc:Localize MainWindow_ClickThroughWindowCheckBox}"
                          VerticalAlignment="Center"
                          Margin="9,5,0,5"
                          VerticalContentAlignment="Center"
                          Click="ClickThroughWindowCheckBox_Click"
                          PreviewKeyDown="CheckBox_PreviewKeyDown" />
                <CheckBox x:Name="DisplayOnKeyPressedOnlyCheckBox"
                          Grid.Column="1"
                          Grid.Row="4"
                          Content="{loc:Localize MainWindow_DisplayOnKeyPressedOnlyCheckBox}"
                          VerticalAlignment="Center"
                          Margin="9,5,0,5"
                          VerticalContentAlignment="Center"
                          Click="DisplayOnKeyPressedOnlyCheckBox_Click"
                          PreviewKeyDown="CheckBox_PreviewKeyDown" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="{loc:Localize MainWindow_WindowKeysGroup}" Margin="0,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>                    
                    <TextBlock Grid.Column="0" Text="{loc:Localize MainWindow_FontLabel}" VerticalAlignment="Center" Padding="0,0,8,0" />
                    <ComboBox x:Name="FontComboBox" Grid.Column="1"
                              xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
                              ItemTemplate="{DynamicResource FontTemplate}"
                              IsSynchronizedWithCurrentItem="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              Height="23"
                              SelectionChanged="FontComboBox_SelectionChanged">
                        <ComboBox.Resources>
                            <CollectionViewSource x:Key="MyFonts" Source="{Binding Source={x:Static Fonts.SystemFontFamilies}}">
                                <CollectionViewSource.SortDescriptions>
                                    <componentModel:SortDescription PropertyName="Source" />
                                </CollectionViewSource.SortDescriptions>
                            </CollectionViewSource>
                            <Style x:Key="FontStyle">
                                <Setter Property="Control.FontFamily" Value="{Binding Source}" />
                                <Setter Property="Control.FontSize" Value="14" />
                            </Style>
                            <DataTemplate x:Key="FontTemplate">
                                <StackPanel VirtualizingStackPanel.IsVirtualizing="True">
                                    <TextBlock Style="{StaticResource FontStyle}" ToolTip="{Binding Source}" Text="{Binding Source}" d:DataContext="{d:DesignData }" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.Resources>
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                        <ComboBox.ItemsSource>
                            <Binding Source="{StaticResource MyFonts}" />
                        </ComboBox.ItemsSource>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <EventSetter Event="RequestBringIntoView" Handler="FontComboBox_RequestBringIntoView" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>                    
                </Grid>
                <Grid Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="27" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="27" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Localize MainWindow_FontSizeLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <RepeatButton x:Name="DecreaseFontSizeRepeatButton"
                            Grid.Column="1"
                            Content="-"
                            Style="{StaticResource VisualStudioRepeatButtonStyle}"
                            Click="DecreaseFontSizeRepeatButton_Click"
                            Margin="0,0,4,0" />
                    <TextBox x:Name="FontSizeTextBox"
                             Grid.Column="2"
                             Width="Auto"
                             Height="23"
                             Style="{StaticResource VisualStudioTextBoxStyle}"
                             HorizontalContentAlignment="Center"
                             TextChanged="FontSizeTextBox_TextChanged" />
                    <RepeatButton x:Name="IncreaseFontSizeRepeatButton"
                            Grid.Column="3"
                            Content="+"
                            Style="{StaticResource VisualStudioRepeatButtonStyle}"
                            Click="IncreaseFontSizeRepeatButton_Click"
                            Margin="4,0,0,0" />
                </Grid>
                <Grid Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Localize MainWindow_FontColorLabel}" Padding="0,3,8,0" />
                    <Button x:Name="FontColorRectangle"
                            Grid.Column="1"
                            Height="23"
                            Width="Auto"
                            Margin="0"
                            Background="#EEEEEE"
                            Style="{StaticResource ColorPickerButtonStyle}"
                            Click="FontColorRectangle_Click" />
                </Grid>
                <Grid Grid.Column="0" Grid.Row="2" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Localize MainWindow_TextAlignmentLabel}" VerticalAlignment="Center" Padding="0,0,8,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button x:Name="LeftAlignmentButton"
                                Tag="0"
                                Style="{StaticResource VisualStudioIconButtonStyle}"
                                Click="LeftAlignmentButton_Click">
                            <Viewbox>
                                <Path Fill="#424242" Data="M915 62H70a70,70 0 1 0 0 140h845a70,70 0 1 0 0-140zM985 613c0-39-31-70-70-70H70a70,70 0 1 0 0 140h845c39 0 70-32 70-70zM70 442h695a70,70 0 1 0 0-140H70a70,70 0 1 0 0 140zM592 853c0-38-31-70-70-70H70a70,70 0 1 0 0 140h452c39 0 70-31 70-70z" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="CenterAlignmentButton"
                                Tag="1"
                                Style="{StaticResource VisualStudioIconButtonStyle}"
                                Margin="4,0"
                                Click="CenterAlignmentButton_Click">
                            <Viewbox>
                                <Path Fill="#424242" Data="M921 65H70a70,70 0 1 0 0 140h851a70,70 0 1 0 0-140zM921 546H70a70,70 0 1 0 0 140h851a70,70 0 1 0 0-140zM804 445a70,70 0 1 0 0-140H187a70,70 0 1 0 0 140h617zM683 926a70,70 0 1 0 0-140H308a70,70 0 1 0 0 140h375z" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="RightAlignmentButton"
                                Tag="0"
                                Style="{StaticResource VisualStudioIconButtonStyle}"
                                Click="RightAlignmentButton_Click">
                            <Viewbox>
                                <Path Fill="#424242" Data="M70 202h845a70,70 0 1 0 0-140H70a70,70 0 1 0 0 140zM915 543H70a70,70 0 1 0 0 140h845a70,70 0 1 0 0-140zM915 302H220a70,70 0 1 0 0 140h695a70,70 0 1 0 0-140zM915 783H463a70,70 0 1 0 0 140h452a70,70 0 1 0 0-140z" />
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="4" Height="18" />

        <Grid Grid.Row="5" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ShowHideWindowButton"
                    Grid.Column="0"
                    Style="{StaticResource VisualStudioButtonStyle}"
                    Click="ShowHideWindowButton_Click"
                    Margin="1,5,5,5" />
            <Button x:Name="MinimizeToTrayButton"
                    Grid.Column="1"
                    Content="{loc:Localize MainWindow_MinimizeToTrayButton}"
                    Style="{StaticResource VisualStudioButtonStyle}"
                    Click="MinimizeToTrayButton_Click"
                    Margin="5" />
            <Button x:Name="DefaultSettingsButton"
                    Grid.Column="2"
                    Content="{loc:Localize MainWindow_ResetSettingsButton}"
                    Style="{StaticResource VisualStudioButtonStyle}"
                    Click="DefaultSettingsButton_Click"
                    Margin="5,5,1,5" />
        </Grid>

        <Grid Grid.Row="6" VerticalAlignment="Bottom" Margin="0,4,2,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="LanguageButton"
                    Grid.Column="0"
                    Style="{StaticResource FlatIconButtonStyle}"
                    ToolTip="{loc:Localize MainWindow_LanguageButtonToolTip}"
                    Click="LanguageButton_Click">
                <Viewbox Width="14" Height="14">
                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M16.36,14C16.44,13.34 16.5,12.68 16.5,12C16.5,11.32 16.44,10.66 16.36,10H19.74C19.9,10.64 20,11.31 20,12C20,12.69 19.9,13.36 19.74,14M14.59,19.56C15.19,18.45 15.65,17.25 15.97,16H18.92C17.96,17.65 16.43,18.93 14.59,19.56M14.34,14H9.66C9.56,13.34 9.5,12.68 9.5,12C9.5,11.32 9.56,10.65 9.66,10H14.34C14.43,10.65 14.5,11.32 14.5,12C14.5,12.68 14.43,13.34 14.34,14M12,19.96C11.17,18.76 10.5,17.43 10.09,16H13.91C13.5,17.43 12.83,18.76 12,19.96M8,8H5.08C6.03,6.34 7.57,5.06 9.4,4.44C8.8,5.55 8.35,6.75 8,8M5.08,16H8C8.35,17.25 8.8,18.45 9.4,19.56C7.57,18.93 6.03,17.65 5.08,16M4.26,14C4.1,13.36 4,12.69 4,12C4,11.31 4.1,10.64 4.26,10H7.64C7.56,10.66 7.5,11.32 7.5,12C7.5,12.68 7.56,13.34 7.64,14M12,4.03C12.83,5.23 13.5,6.57 13.91,8H10.09C10.5,6.57 11.17,5.23 12,4.03M18.92,8H15.97C15.65,6.75 15.19,5.55 14.59,4.44C16.43,5.07 17.96,6.34 18.92,8M12,2C6.47,2 2,6.5 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" />
                </Viewbox>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,0,0">
                <TextBlock x:Name="VersionTextBlock" VerticalAlignment="Top" FontSize="11" />
                <TextBlock x:Name="AboutTextBlock"
                           Margin="3,0,0,0"
                           VerticalAlignment="Top"
                           FontSize="11"
                           Cursor="Hand"
                           MouseLeftButtonUp="TextBlock_MouseLeftButtonUp"
                           Style="{StaticResource HoverUnderlineStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
