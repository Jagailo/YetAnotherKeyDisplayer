<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>YAKD</RootNamespace>
    <AssemblyName>YAKD</AssemblyName>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- RTSSSharedMemoryNET is built as x86 for Any CPU, so the process has to stay 32-bit. -->
    <Prefer32Bit>true</Prefer32Bit>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ApplicationIcon>Images\Icons\main-icon.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.6.0</Version>
    <AssemblyVersion>1.6.0.0</AssemblyVersion>
    <FileVersion>1.6.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>Yet Another Key Displayer</AssemblyTitle>
    <Product>Yet Another Key Displayer</Product>
    <Description>Displays pressed keyboard and mouse keys in a window or in the RTSS overlay.</Description>
    <Company>Alexey Yagelo</Company>
    <Authors>Alexey Yagelo</Authors>
    <Copyright>Copyright © 2018–2026 Alexey Yagelo</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <RepositoryUrl>https://github.com/Jagailo/YetAnotherKeyDisplayer</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Extended.Wpf.Toolkit" Version="5.1.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RTSSCustomOSD\RTSSSharedMemoryNET.vcxproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\Roboto-Regular.ttf" />
    <Resource Include="Images\Icons\main-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings" Generator="SettingsSingleFileGenerator" LastGenOutput="Settings.Designer.cs" />
    <Compile Update="Properties\Settings.Designer.cs" AutoGen="True" DependentUpon="Settings.settings" DesignTimeSharedInput="True" />
    <EmbeddedResource Update="Localization\Strings.resx" Generator="PublicResXFileCodeGenerator" LastGenOutput="Strings.Designer.cs" />
    <Compile Update="Localization\Strings.Designer.cs" AutoGen="True" DesignTime="True" DependentUpon="Strings.resx" />
  </ItemGroup>

</Project>
