<Window x:Class="YAKD.RTSSWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:YAKD.Localization"
        mc:Ignorable="d"
        Title="{loc:Localize RtssWindow_Title}"
        Height="250"
        Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        Foreground="#1E1E1E"
        FontFamily="{StaticResource RobotoRegular}"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock TextWrapping="Wrap"
                       Text="{loc:Localize RtssWindow_Description}"
                       Margin="10" />
            <TextBlock x:Name="RTSSPathTextBlock"
                       TextWrapping="Wrap"
                       Margin="10" />
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="DownloadRTSSButton"
                    Content="{loc:Localize RtssWindow_DownloadButton}"
                    Style="{StaticResource VisualStudioButtonStyle}"
                    Margin="0,5,5,5"
                    Click="DownloadRTSSButton_Click" />
            <Button x:Name="FindRTSSButton"
                    Content="{loc:Localize RtssWindow_SpecifyPathButton}"
                    Style="{StaticResource VisualStudioButtonStyle}"
                    Margin="0,5,5,5"
                    Click="FindRTSSButton_Click" />
            <Button x:Name="CancelButton"
                    Content="{loc:Localize Common_Cancel}"
                    Style="{StaticResource VisualStudioButtonStyle}"
                    Margin="0,5,5,5"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>